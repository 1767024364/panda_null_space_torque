<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
    <xacro:arg name="headless" default="true"/>



    <ros2_control name="PandaMujocoSystem" type="system">
        <hardware>
            <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
            <param name="headless">$(arg headless)</param>
            <param name="mujoco_model">$(find panda_description)/mujoco/scene_tau.xml</param>
            <param name="initial_keyframe">home</param>
        </hardware>

        <joint name="joint1">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint2">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

         <joint name="joint3">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>  

        <joint name="joint4">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint5">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint6">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint7">
            <command_interface name="effort">
                <param name="min">-3000.0</param>
                <param name="max">3000.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>



</robot>